PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=baby_shop_management

# QUAN TRỌNG: Thay đổi giá trị JWT_SECRET bằng chuỗi ngẫu nhiên dài (ít nhất 32 ký tự)
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-random-secret

DB_HOST=localhost
DB_PORT=3306
DB_NAME=baby_shop_management
DB_USER=root
DB_PASSWORD=

# CẤU HÌNH GỬI EMAIL HÓA ĐƠN (Tùy chọn - nếu để trống hệ thống tự chạy chế độ mô phỏng an toàn)
# Hướng dẫn dùng Gmail: Bật 2FA -> Tạo Mật khẩu ứng dụng (App Password 16 chữ cái)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password
# MAIL_FROM="Cửa hàng Mẹ & Bé" <your_email@gmail.com>
